# Line endings are decided here rather than by each clone's core.autocrlf. `text=auto` stores
# text as LF and checks it out in the platform's convention; no tracked blob currently holds a CR,
# so this is a no-op for history and only makes the existing behaviour explicit.
* text=auto

# seq2waveform/_core.pyi is generated by nanobind, committed, and byte-compared by
# `pixi run check-stub`. Pin its line endings so that comparison means the same thing on every
# platform, rather than depending on whoever last built it and on their core.autocrlf setting.
*.pyi text eol=lf

# Workflow YAML carries shell heredocs, which a stray CR would break on a Linux runner. The
# blob is LF either way, but pinning it means that does not depend on anyone's core.autocrlf.
*.yml text eol=lf
